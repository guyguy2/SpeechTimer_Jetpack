<resources>
    <string name="app_name">Simple Speech Timer</string>

    <!-- Phase chip on the timer screen (visible) -->
    <string name="phase_label_before_green">Before green</string>
    <string name="phase_label_green">Green: minimum reached</string>
    <string name="phase_label_yellow">Yellow: wrap up soon</string>
    <string name="phase_label_red">Red: maximum reached</string>

    <!-- Phase as spoken after the time, for example "1 minute 4 seconds, green phase" -->
    <string name="phase_spoken_before_green">before green</string>
    <string name="phase_spoken_green">green phase</string>
    <string name="phase_spoken_yellow">yellow phase</string>
    <string name="phase_spoken_red">red phase</string>

    <!-- Accessible names of the timer buttons -->
    <string name="timer_action_start">Start timer</string>
    <string name="timer_action_pause">Pause timer</string>
    <string name="timer_action_restart">Restart timer</string>
    <string name="timer_action_save">Save result</string>

    <!-- Accessible names of the From and To steppers on the custom range screen -->
    <string name="stepper_increase_minimum">Increase minimum minutes</string>
    <string name="stepper_decrease_minimum">Decrease minimum minutes</string>
    <string name="stepper_increase_maximum">Increase maximum minutes</string>
    <string name="stepper_decrease_maximum">Decrease maximum minutes</string>

    <!-- Name of the elapsed-time progress bar -->
    <string name="timer_progress_description">Time progress</string>

    <!-- Shown under the digits while the timer is paused -->
